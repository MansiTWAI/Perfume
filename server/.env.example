# Copy to server/.env for local development. On Vercel, add these in
# Project Settings → Environment Variables instead.
PORT=5000
NODE_ENV=development
# MongoDB Atlas connection string, including the database name (albarakah)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/albarakah?retryWrites=true&w=majority
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=
# Public URL used in sitemap.xml and share tags, e.g. https://albarakah.me
SITE_URL=
CLIENT_ORIGIN=
# Cloudinary image storage (server-side only). Leave empty to store uploads in MongoDB.
# Either CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name> or the three below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=albarakah
# Password-reset email over SMTP (Gmail app password, Zoho, Brevo, SES…). Leave empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AL BARAKAH LIFESTYLE <no-reply@albarakah.me>
# Online payment (India) with Razorpay. Leave empty to disable "Pay online".
# Use Test Mode keys (rzp_test_...) on development/staging and Live keys
# (rzp_live_...) only on the production server. Server-side only: never put
# these in the client or in any VITE_ variable.
# Razorpay Dashboard -> Account & Settings -> Payment capture: Automatic.
# Webhook (Dashboard -> Webhooks): https://<your-domain>/api/payments/razorpay/webhook
#   events: payment.captured, payment.failed, order.paid, refund.created,
#   refund.processed, refund.failed; the secret you set there goes below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Sign-in by one-time code over WhatsApp (Meta Cloud API). Needs an approved
# "Authentication" template with a copy-code button. Leave empty to disable
# (development servers then return the code in the response as devCode).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Push notifications (Firebase Cloud Messaging) — device tokens are stored via
# POST /devices/register; sending is not wired up yet.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# AI concierge (Google Gemini). Server-side only; leave empty to keep the
# WhatsApp concierge button instead of the chat. GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Thinking level: minimal | low (default, fast) | medium | high | off
GEMINI_THINKING=low
