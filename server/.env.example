# Copy to server/.env for local development. On Vercel, add these in
# Project Settings → Environment Variables instead.
PORT=5000
NODE_ENV=development
# MongoDB Atlas connection string, including the database name (albarakah)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/albarakah?retryWrites=true&w=majority
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=
# Public URL used in sitemap.xml and share tags, e.g. https://albarakah.me
SITE_URL=
CLIENT_ORIGIN=
# Cloudinary image storage (server-side only). Leave empty to store uploads in MongoDB.
# Either CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name> or the three below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=albarakah
# Email over SMTP: sign-in codes, the staff two-step code, password reset and
# shipping updates. REQUIRED in production: without it staff cannot sign in.
# cPanel mailbox (Hostingial): SMTP_HOST=mail.albarakah.me, SMTP_PORT=465,
# SMTP_SECURE=true, SMTP_USER=<full mailbox address>, SMTP_PASS=<its password>,
# MAIL_FROM=AL BARAKAH LIFESTYLE <the same address>. Server-side only; never commit.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AL BARAKAH LIFESTYLE <no-reply@albarakah.me>
# Online payment (India) with Razorpay. Leave empty to disable "Pay online".
# Use Test Mode keys (rzp_test_...) on development/staging and Live keys
# (rzp_live_...) only on the production server. Server-side only: never put
# these in the client or in any VITE_ variable.
# Razorpay Dashboard -> Account & Settings -> Payment capture: Automatic.
# Webhook (Dashboard -> Webhooks): https://<your-domain>/api/payments/razorpay/webhook
#   events: payment.captured, payment.failed, order.paid, refund.created,
#   refund.processed, refund.failed; the secret you set there goes below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Sign-in by one-time code over WhatsApp (Meta Cloud API). Needs an approved
# "Authentication" template with a copy-code button. Leave empty to disable
# (development servers then return the code in the response as devCode).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# WhatsApp updates to subscribers (admin > WhatsApp). Uses the token and phone
# number above plus an approved "Marketing" template whose body has two
# variables, e.g. "Hello {{1}}, {{2}}" (name, then the team's message) and the
# footer "Reply STOP to unsubscribe". Use WHATSAPP_NOTIFY_PARAMS=message for a
# template with one variable. Status webhook (delivered / read / failed and
# STOP replies): https://<site>/api/whatsapp/webhook, verified with the token
# below and signed with the Meta app secret.
WHATSAPP_NOTIFY_TEMPLATE=
WHATSAPP_NOTIFY_PARAMS=name,message
# Optional: the same template with an IMAGE header and a URL button whose
# link is https://albarakah.me/{{1}}. Used when a message has a picture, so it
# arrives with the picture and a "Shop Now" button. Without it, messages go as
# text with the link at the end. (Pictures must be JPG or PNG.)
WHATSAPP_NOTIFY_MEDIA_TEMPLATE=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Push notifications (Firebase Cloud Messaging) — device tokens are stored via
# POST /devices/register; sending is not wired up yet.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# AI concierge (Google Gemini). Server-side only; leave empty to keep the
# WhatsApp concierge button instead of the chat. GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Thinking level: minimal | low (default, fast) | medium | high | off
GEMINI_THINKING=low

# Delhivery (India shipping). Get the API token and the exact pickup
# (warehouse) name from your Delhivery account manager / Delhivery One →
# Developer Portal. Use the staging token with DELHIVERY_ENV=staging first.
# Without a token, shipping stays manual (admin types courier + AWB).
DELHIVERY_API_TOKEN=
DELHIVERY_ENV=staging
DELHIVERY_PICKUP_LOCATION=
# Shared secret for scan push. Give Delhivery support the URL
# https://albarakah.me/api/shipping/delhivery/webhook and the header
# "Authorization: Bearer <this value>". 32+ random characters.
DELHIVERY_WEBHOOK_TOKEN=
# Create the shipment automatically once an order is paid (or a COD order is
# confirmed). false = only from the admin "Create shipment" button.
DELHIVERY_AUTO_CREATE=true
# Tracking poll interval (minutes) as a backstop to scan push.
DELHIVERY_POLL_MINUTES=30
# Parcel defaults: grams per boxed bottle, packaging grams, box size (cm).
DELHIVERY_ITEM_WEIGHT_G=350
DELHIVERY_BOX_WEIGHT_G=150
DELHIVERY_BOX_L_CM=20
DELHIVERY_BOX_W_CM=15
DELHIVERY_BOX_H_CM=12
DELHIVERY_SHIPPING_MODE=Surface
DELHIVERY_HSN_CODE=33030010
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_SELLER_NAME=AL BARAKAH LIFESTYLE
# Online orders never paid are released (stock and coupon given back) after
# this many minutes, once Razorpay confirms nothing was paid. Minimum 15.
PAYMENT_HOLD_MINUTES=60
